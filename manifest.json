{
  "name": "NotePlus",
  "short_name": "NotePlus",
  "description": "NotePlus is a free, online, browser-based text editor with AI integration and more that provides an experience similar to Windows Notepad",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./public/img/icon512.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./public/img/icon512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./public/img/banner.jpg",
      "sizes": "1280x720",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "NotePlus Loading Screen"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Text Files",
      "accept": {
        "text/plain": [
          ".txt",
          ".md",
          ".log",
          ".conf",
          ".ini",
          ".env"
        ],
        "text/javascript": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ],
        "text/css": [
          ".css",
          ".scss",
          ".sass",
          ".less"
        ],
        "text/html": [
          ".html",
          ".htm",
          ".vue",
          ".svelte"
        ],
        "application/json": [
          ".json",
          ".prettierrc"
        ]
      }
    }
  ]
}